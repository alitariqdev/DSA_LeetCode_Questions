class Solution:
    def evalRPN(self, tokens: list[str]) -> int:

        stack = []

        for token in tokens:
            if token == "+":
                b = stack.pop()
                a = stack.pop()
                res = b + a
                stack.append(res)
            elif token == "-":
                b = stack.pop()
                a = stack.pop()
                res = a - b
                stack.append(res)
        
            elif token == "*":
                b = stack.pop()
                a = stack.pop()
                res = b * a
                stack.append(res)
        
            elif token == "/":
                b = stack.pop()
                a = stack.pop()
                res = int(a / b)
                stack.append(res)
            else:
                stack.append(int(token))

        return stack[-1]
